# ===========================================
# Web1C Shop - Environment Configuration
# ===========================================
# Скопируйте этот файл в .env и заполните значения

# -------------------------------------------
# 1C:УТ OData Configuration
# -------------------------------------------
# Адрес публикации OData в 1С (без trailing slash)
ONEC_URL=https://rucheek.cloudpub.ru/trade2025/odata/standard.odata/

# Пользователь 1С с правами на OData
ONEC_USER=tsd
ONEC_PASSWORD=123

# -------------------------------------------
# Database Configuration
# -------------------------------------------
POSTGRES_PASSWORD=web1c_secret_change_in_production

# -------------------------------------------
# JWT Secret for Authentication
# -------------------------------------------
# Сгенерируйте случайную строку для production
JWT_SECRET=web1c_jwt_secret_key_change_in_production_use_openssl_rand

# -------------------------------------------
# Application URL
# -------------------------------------------
APP_URL=http://localhost

# -------------------------------------------
# Redis Configuration (optional custom)
# -------------------------------------------
# REDIS_URL=redis://redis:6379

# -------------------------------------------
# Upload Configuration
# -------------------------------------------
# Максимальный размер загружаемого файла (в байтах)
MAX_UPLOAD_SIZE=10485760

# -------------------------------------------
# Sync Configuration
# -------------------------------------------
# Интервал синхронизации в секундах
SYNC_INTERVAL=300

# -------------------------------------------
# Debug Mode (development only)
# -------------------------------------------
# DEBUG=true
